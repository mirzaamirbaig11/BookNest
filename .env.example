# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/booknest?schema=public"

# Random 32+ char secret used to sign session JWTs (generate with: openssl rand -base64 48)
AUTH_SECRET=""

# Admin login — the password is set here, NEVER hardcoded in source
ADMIN_EMAIL="mirzaamirbaig54@gmail.com"
ADMIN_PASSWORD=""

# Merchant UPI ID used to build dynamic payment QR codes
UPI_ID="9117429345@ybl"
UPI_MERCHANT_NAME="BookNest"

# File storage. MODE=local stores files under /public/uploads (fine for dev/small deployments).
# MODE=s3 stores files in an S3-compatible bucket (recommended for production).
STORAGE_MODE="local"
STORAGE_URL=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Outgoing email for password reset links
EMAIL_SERVER=""
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="BookNest <no-reply@booknest.example>"

# "test" or "production" — controls the payment-mode banner and keeps test orders flagged
PAYMENT_MODE="test"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
